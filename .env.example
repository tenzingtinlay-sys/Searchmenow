PORT=3000
# Optional: enables breach search. Get a key at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# Optional: raises GitHub rate limits for People search
GITHUB_SEARCH_TOKEN=
# Free API requests per key per day
API_DAILY_LIMIT=100
# Optional: APILayer marketplace key (https://apilayer.com). Subscribe to Number Verification,
# Email Verification and IP to Location (free tiers) and it powers the Phone/Email/IP lookup.
APILAYER_API_KEY=
# Optional: Cloudflare Web Analytics site token (dash.cloudflare.com > Analytics & Logs > Web Analytics)
CF_BEACON_TOKEN=
# Searches per day on the Free plan. Empty = unlimited (default)
FREE_DAILY_SEARCHES=
# true = Billing "Upgrade" switches plans without payment (testing only)
BILLING_DEMO=false
# The production site host, without https://, once backend host validation is configured.
SITE_HOST=searchmenow.pages.dev
# true = let any website call the API from the browser (CORS *) — use only for testing
API_CORS_ANY=false

# Optional Google Cloud API key (server-side only). Enable YouTube Data API v3 and Places API (New).
# Configure this as a Cloudflare Worker/Container secret, never in public frontend code.
GOOGLE_API_KEY=
