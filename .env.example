PORT=3000
# Optional: enables Breach search. Get a key at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# Optional: raises GitHub rate limits for People search
GITHUB_SEARCH_TOKEN=
# Free API requests per key per day
API_DAILY_LIMIT=100
# Optional: APILayer marketplace key (https://apilayer.com). Subscribe to Number Verification,
# Email Verification and IP to Location (free tiers) and it powers the Phone/Email/IP lookup.
APILAYER_API_KEY=
# Optional: Cloudflare Web Analytics site token (dash.cloudflare.com > Analytics & Logs > Web Analytics)
CF_BEACON_TOKEN=
# Searches per day on the Free plan
FREE_DAILY_SEARCHES=10
# true = Billing "Upgrade" switches plans without payment (testing only)
BILLING_DEMO=false
